REPLICATE_API_TOKEN=your_replicate_api_token_here
POSTGRES_DB=food_ai_db
POSTGRES_USER=food_ai_user
POSTGRES_PASSWORD=SUA_SENHA
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# REQUIRED in production (raising an error if missing when DJANGO_DEBUG=False).
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,food-ai-backend,web

# Comma-separated CORS/CSRF origins. Provide both HTTP and HTTPS as needed.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://localhost:8443,https://127.0.0.1:8443
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://localhost:8443,https://127.0.0.1:8443,http://backend:8000

# Redis host used by the Channels channel layer (service name inside compose).
REDIS_HOST=redis

# Escola 42 (Intra 42) OAuth 2.0.
# Register an app at https://profile.intra.42.fr/oauth/applications/new.
# FORTY_TWO_REDIRECT_URI must be registered there and match exactly the
# callback route below (default assumes local https frontend).
FORTY_TWO_CLIENT_ID=your_42_client_id_here
FORTY_TWO_CLIENT_SECRET=your_42_client_secret_here
FORTY_TWO_REDIRECT_URI=https://localhost:8443/api/auth/42/callback
FORTY_TWO_SUCCESS_URL=https://localhost:8443/oauth/success
